# NVIDIA Nemotron through Nebius Token Factory
NEBIUS_API_KEY=
NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1/
NEBIUS_MODEL=nvidia/Nemotron-3_5-Lightning
NEBIUS_ENABLED=true

# Optional current internship web search. Demo Mode does not need this key.
TAVILY_API_KEY=
TAVILY_ENABLED=true

# SQLite file stored locally at the repository root by default
INTERNSHIP_HUNTER_DATABASE_URL=sqlite:///./internship_agent.db
